#!/usr/bin/env bash

set -o errexit  # Abort on nonzero exit code.
set -o noglob   # Disable globbing.
set +o xtrace   # Disable debug mode.
set -o pipefail # Don't hide errors within pipes.

# Restrict new password file permissions to only the current user.
umask 077

readonly VERSION="3.3"
readonly NAME="BashPass"
readonly SCRIPT_NAME="${0##*/}"

error() {
    local error_msg="${1}"
    local error_code="${2}"

    printf 'Error: %s.\n' "${error_msg}" >&2
    exit "${error_code}"
}

[[ "${UID}" -eq 0 ]] && error 'cannot run with superuser privileges' 1

# A user may have multiple GnuPG keys configured on their system, therefore
# when no key ID is configured, it's a good idea to prompt the user to enter
# one as long as none is configured.
#
# This will not make the key ID persistent. The user should still set the
# environment variable himself to use a specific key ID every time BashPass is
# run.
ask_for_key_id() {
    local key_id

    while ! [[ ${key_id} =~ ^[0-9A-Fa-f]{8,40}$ ]]; do
        read -rp 'Enter the GPG key ID: ' key_id
    done

    printf '%s' "$key_id"
}

# The following variables will be used to store the user's settings. When no
# value is configured using "$BASHPASS_*" environment variables, the user will
# either be prompted to enter the value, or a default value will be used.
readonly CLIPBOARD_CLEAR_CMD="${BASHPASS_CLIPBOARD_CLEAR_CMD:-wl-copy --clear}"
readonly CLIPBOARD_COPY_CMD="${BASHPASS_CLIPBOARD_COPY_CMD:-wl-copy}"
readonly CLIPBOARD_TIMER="${BASHPASS_CLIPBOARD_TIMER:-10}"
readonly KEY_ID="${BASHPASS_KEY_ID:-$(ask_for_key_id)}"
readonly PASSWD_LENGTH="${BASHPASS_PASSWD_LENGTH:-14}"
readonly PASSWD_STORE="${BASHPASS_PASSWD_STORE:-${HOME}/.local/share/bashpass}"

[[ "${PASSWD_LENGTH}" =~ ^[1-9][0-9]*$ ]] ||
    error 'invalid BASHPASS_PASSWD_LENGTH, must be a positive number' 2

[[ "${CLIPBOARD_TIMER}" =~ ^[0-9]+$ ]] ||
    error 'invalid BASHPASS_TIMER, must be a positive number' 2

mkdir -p "${PASSWD_STORE}" ||
    error 'cannot create password store directory' 1

usage() {
    printf '%s' "\
${NAME}, a password manager written in Bash.

Usage:
    ${SCRIPT_NAME} [OPTION] [NAME]

Commands:
    -a, --add [NAME]       Add a password.
    -c, --copy [NAME]      Copy a password to the clipboard.
    -d, --delete [NAME]    Delete a password.
    -l, --list             List all passwords.
    -s, --show [NAME]      Show a password.
    -u, --update [NAME]    Update a password.
    -G, --git COMMAND      Interact with Git. Wrapper for 'git -C \${BASHPASS_PASSWD_STORE} COMMAND'.

Options:
    -h, --help             Show this help message.
    -v, --version          Show the version number.

Arguments:
    NAME                   Password name. If omitted, you will be prompted.

Environment:
    BASHPASS_CLIPBOARD_CLEAR_CMD
    BASHPASS_CLIPBOARD_COPY_CMD
    BASHPASS_CLIPBOARD_TIMER
    BASHPASS_KEY_ID
    BASHPASS_PASSWD_LENGTH
    BASHPASS_PASSWD_STORE
"
}

version() {
    printf 'BashPass version: %s' "${VERSION}"
    printf '\n'
}

# Surprisingly, 'sleep' is an external program and not a Bash built-in.
# So their is a small possibility that it is not installed on a system,
# although it is very unlikely. We can use 'read' to replace the 'sleep'
# command.
sleep() {
    read -rt "${1}" <> <(:) || :
}

# Wrapper for 'command -v' to avoid spamming '> /dev/null'.
# It also protects against user aliasses and functions.
has() {
    local command
    command=$(command -v "${1}") 2> /dev/null || return 2
    [[ -x ${command} ]] || return  1
}

set_passwd_name() {
    local passwd_name="${1}"
    local functionality="${2}"
    [[ -z "${passwd_name}" ]] && \
        read -rp "Enter the password name to ${functionality}: " passwd_name

    [[ $passwd_name =~ ^[A-Za-z0-9_.@+-]+$ ]] || \
        error 'password name contains invalid characters' 2

    printf '%s' "${passwd_name}"
}

set_passwd() {
    local passwd_name="${1}"
    local gen passwd passwd1 passwd2 passwd_length

    # This function's stdout is piped to GPG, so stdin is no longer connected
    # to the terminal. We open /dev/tty on file descriptor 3 so interactive input
    # and output use the terminal instead of the pipe, leaving stdout for the
    # plaintext password passed to GPG.
    exec 3<>/dev/tty || error 'cannot open terminal' 1

    read -u 3 -rp 'Generate a password? [Y/n]: ' gen

    case "${gen}" in
        [Nn])
            read -u 3 -rsp 'Enter the password: ' passwd1
            printf '\n' >&3

            [[ -z "${passwd1}" ]] && error 'password cannot be empty' 2

            while [[ "${passwd1}" != "${passwd2}" ]]; do
                read -u 3 -rsp 'Re-enter the password: ' passwd2
                printf '\n' >&3
            done

            passwd="${passwd1}"
            ;;
        *)
            read -u 3 -rp "Enter the password length (default ${PASSWD_LENGTH}): " \
                passwd_length

            [[ -z "${passwd_length}" ]] && passwd_length="${PASSWD_LENGTH}"
            [[ ${passwd_length} =~ ^[1-9]([0-9])?+$ ]] || \
                error "the password length must be a number." 1

            passwd=$(LC_ALL=C \
                tr -dc 'A-Za-z0-9!"#$%&'\''()*+,-./:;<=>?@[\]^_`{|}~' < /dev/urandom | \
                dd ibs=1 obs=1 count="${passwd_length}" 2> /dev/null) || :
            ;;
    esac

    [[ -z "${passwd}" ]] && error 'password cannot be empty' 2

    printf '%s' "${passwd}"

    # Since we opened /dev/tty for the interactive input, we need to close it.
    exec 3>&-
}

encrypt_passwd() {
    local passwd_file="${1}"

    "${GPG_CMD}" --batch --yes --encrypt --quiet --output "${passwd_file}" --recipient "${KEY_ID}"
}

decrypt_passwd() {
    local passwd_file="${1}"

    "${GPG_CMD}" --decrypt --quiet --output - "${passwd_file}"
}

check_passwd_exists() {
    local passwd_name="${1}"
    [[ -f "${PASSWD_STORE}/${passwd_name}.gpg" ]] || \
        error "password '${passwd_name}' not found" 2
}

add_passwd() {
    local passwd_name="${1}"
    local passwd_file
    local overwrite
    passwd_name=$(set_passwd_name "${passwd_name}" 'add')
    passwd_file="${PASSWD_STORE}/${passwd_name}.gpg"

    while [[ -f "${passwd_file}" ]]; do
        read -rp \
            "Password '${passwd_name}' already exists. Overwrite? [y/N]: " \
            overwrite

        case "${overwrite}" in
            [Yy])
                break
                ;;
            *)
                read -rp 'Enter a new password name: ' passwd_name
                passwd_file="${PASSWD_STORE}/${passwd_name}.gpg"
                ;;
        esac
    done

    set_passwd "${passwd_name}" | encrypt_passwd "${passwd_file}"

    printf 'Password added successfully.\n'
}

update_passwd() {
    local passwd_name="${1}"
    local passwd_file
    passwd_name=$(set_passwd_name "${passwd_name}" 'update')
    passwd_file="${PASSWD_STORE}/${passwd_name}.gpg"

    check_passwd_exists "${passwd_name}"
    set_passwd "${passwd_name}" | encrypt_passwd "${passwd_file}"

    printf 'Password updated successfully.\n'
}

delete_passwd() {
    local passwd_name="${1}"
    local passwd_file
    passwd_name=$(set_passwd_name "${passwd_name}" 'delete')
    passwd_file="${PASSWD_STORE}/${passwd_name}.gpg"

    check_passwd_exists "${passwd_name}"
    rm -f -- "${passwd_file}"

    printf 'Password deleted successfully.\n'
}

show_passwd() {
    local passwd_name="${1}"
    local passwd_file
    passwd_name=$(set_passwd_name "${passwd_name}" 'show')
    passwd_file="${PASSWD_STORE}/${passwd_name}.gpg"

    check_passwd_exists "${passwd_name}"
    printf '%s\n' "$(decrypt_passwd "${passwd_file}")"
}

list_passwd() {
    local passwd_name

    printf 'The following passwords are stored:\n'

    set +o noglob
    for passwd_name in "${PASSWD_STORE:?}"/*.gpg; do
        passwd_name="${passwd_name##*/}"
        passwd_name="${passwd_name%%.gpg}"
        printf '%s\n' "${passwd_name}"
    done
    set -o noglob
}

copy_passwd() {
    local passwd_name="${1}"
    local passwd_file
    passwd_name=$(set_passwd_name "${passwd_name}" 'copy')
    passwd_file="${PASSWD_STORE}/${passwd_name}.gpg"

    check_passwd_exists "${passwd_name}"

    [[ -n "${CLIPBOARD_COPY_CMD}" ]] ||
        error 'clipboard copy command is not configured' 1

    [[ -n "${CLIPBOARD_CLEAR_CMD}" ]] ||
        error 'clipboard clear command is not configured' 1

    # Ignore terminal interrupts (CTRL+C).
    # We do this to prevent the ability to kill the script while
    # the password is still in the clipboard.
    trap '' INT

    ${CLIPBOARD_COPY_CMD} "$(decrypt_passwd "${passwd_file}")" || \
        error 'failed to copy password to clipboard' 1

    sleep "${CLIPBOARD_TIMER}" || kill 0

    ${CLIPBOARD_CLEAR_CMD} || error 'failed to clear clipboard' 1

    printf 'Clipboard has been cleared to ensure it cannot be leaked.\n'
}

git_passwd() {
    has git || error 'git is not installed' 1

    git -C "${PASSWD_STORE}" "${@}"
}

if has gpg2; then
    readonly GPG_CMD="gpg2"
elif has gpg; then
    readonly GPG_CMD="gpg"
else
    error "GnuPG is not installed" 1
fi

case "${1}" in
    "--add"    | "-a") add_passwd "${2}";;
    "--copy"   | "-c") copy_passwd "${2}";;
    "--delete" | "-d") delete_passwd "${2}";;
    "--help"   | "-h") usage;;
    "--list"   | "-l") list_passwd;;
    "--show"   | "-s") show_passwd "${2}";;
    "--git"    | "-G") git_passwd "${@:2}";;
    "--update" | "-u") update_passwd "${2}";;
    "--version"| "-v") version;;
    *)
        usage >&2
        printf '\n' >&2
        error "option '${1}' not found" 2
        ;;
esac
